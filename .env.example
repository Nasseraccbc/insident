# ============================================================================
#  قالب متغيّرات البيئة — نظام إدارة التشغيل والصيانة
#  انسخ هذا الملف باسم .env واملأ القيم. الملف .env محجوب عن Git.
#
#      cp .env.example .env
# ============================================================================


# ─── ١) عامّ وآمن للنشر ──────────────────────────────────────────────────────
# هذان يدخلان في كود الصفحة نفسها، وأي زائر يراهما بـ"عرض المصدر".
# حمايتهما من سياسات RLS في قاعدة البيانات، لا من إخفائهما.
# المصدر: Supabase Dashboard ← Settings ← API

SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=


# ─── ٢) سرّي: لا يُرفع ولا يُلصق في محادثة ────────────────────────────────────
# توكن على مستوى الحساب كله — يقرأ ويعدّل ويحذف كل المشاريع.
# يُستخدم مرة واحدة لبناء الجداول عبر Supabase Management API، ثم يُلغى.
# المصدر: https://supabase.com/dashboard/account/tokens
#
# ⚠️ بعد انتهاء بناء القاعدة: Account ← Access Tokens ← Revoke

SUPABASE_ACCESS_TOKEN=


# معرّف المشروع — الجزء بين https:// و .supabase.co في SUPABASE_URL
# مثال: https://abcdefghijklmnop.supabase.co  ←  abcdefghijklmnop

SUPABASE_PROJECT_REF=


# ─── ٣) لا تضعه هنا إطلاقاً ─────────────────────────────────────────────────
# service_role key  ← يتجاوز RLS كاملاً. لا حاجة له في هذا المشروع.
# كلمة مرور قاعدة البيانات / connection string  ← لا حاجة لهما.
